<file path="src/screens/EventScreen.tsx">
import { useGame, patch } from '../app/store';
import { StatusBar } from '../ui/StatusBar';
import { Button } from '../ui/Button';
import { goTo } from '../systems/fsm';
import { applyEventEffect } from '../systems/eventSystem';
import { applyDebtEffect } from '../systems/debtSystem';

export function EventScreen() {
  const activeEvent = useGame(s => s.activeEvent) as any;
  if (!activeEvent) return null;

  const handleChoice = (choice: any) => {
    // คำนวณค่าสถานะใหม่
    const newStats = applyEventEffect(choice.effect);

    // ถ้าตัวเลือกนี้มีผลต่อระบบหนี้ (เหตุการณ์เจ้าหนี้) ให้จัดการด้วย
    if (choice.debtEffect) {
      applyDebtEffect(choice.debtEffect);
    }

    patch({
      stats: newStats,
      lastResult: { title: activeEvent.title, lines: [choice.resultText] },
      activeEvent: null,
    });

    if (newStats.money < 0 || newStats.sanity <= 0) {
      goTo('gameOver');
      return;
    }
    goTo('home');
  };

  return (
    <>
      <StatusBar />
      <div className="flex-1 flex flex-col items-center justify-center p-6 gap-6 bg-neutral-900/95 screen-motion">
        <div className="w-24 h-24 rounded-full bg-neutral-800 border-2 border-red-500/30 flex items-center justify-center text-5xl shadow-[0_0_30px_rgba(239,68,68,0.2)] animate-pulse">
          {activeEvent.icon}
        </div>
        <div className="text-center space-y-2">
          <div className="text-[10px] uppercase tracking-[0.3em] text-red-400 font-bold">Unexpected Event</div>
          <h2 className="text-xl font-bold text-white">{activeEvent.title}</h2>
          <p className="text-sm text-neutral-300 leading-relaxed px-2">
            {activeEvent.description}
          </p>
        </div>
        <div className="w-full space-y-3 mt-4">
          {activeEvent.choices.map((choice: any, index: number) => (
            <Button
              key={index}
              variant={index === 0 ? 'primary' : 'secondary'}
              onClick={() => handleChoice(choice)}
              className="text-left justify-start !py-4"
            >
              {choice.label}
            </Button>
          ))}
        </div>
      </div>
    </>
  );
}
</file>

<file path="src/systems/lifeSystem.ts">
import { NORMAL_LIFE, CLAMP } from '../app/constants';
import { patch, pushLog, useGame } from '../app/store';
import { goTo } from './fsm';
import { consumeBlocks } from './timeSystem';
import { rollRandomEvent } from './eventSystem';

const clamp = (v: number, [lo, hi]: [number, number]) =>
  Math.max(lo, Math.min(hi, v));

export function doNormalLife(action: keyof typeof NORMAL_LIFE): void {
  const s = useGame.getState();
  const cfg = NORMAL_LIFE[action];

  const stats = {
    ...s.stats,
    money: s.stats.money + cfg.money,
    heat: clamp(s.stats.heat + cfg.heat, CLAMP.heat),
    sanity: clamp(s.stats.sanity + cfg.sanity, CLAMP.sanity),
  };

  const sign = (n: number) => (n >= 0 ? `+${n}` : `${n}`);
  patch({
    stats,
    lastResult: {
      title: cfg.label,
      lines: [`💰 ${sign(cfg.money)}`, `🔥 ${sign(cfg.heat)}`, `🧠 ${sign(cfg.sanity)}`],
    },
  });
  pushLog(`${cfg.label} — $${cfg.money}, 🔥${cfg.heat}, 🧠${cfg.sanity}`);

  consumeBlocks(1);

  // ถ้า action ทำให้ sanity แตะ 0 หลัง consumeBlocks แต่ยังอยู่ home
  const final = useGame.getState();
  if (final.screen === 'home' && (final.stats.sanity <= 0 || final.stats.money < 0)) {
    goTo('gameOver');
    return;
  }
  // เช็คสุ่ม Event (ถ้าจบวันแล้วจะไม่ทำงาน)
  if (final.screen === 'home') {
    const ev = rollRandomEvent();
    if (ev) {
      patch({ activeEvent: ev });
      goTo('event'); // เด้งไปหน้า Event
    }
  }
}
