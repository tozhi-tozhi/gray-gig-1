  overflow: hidden;
  background: linear-gradient(115deg, rgba(36, 46, 40, 0.8), rgba(22, 29, 24, 0.82));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.035), 0 6px 18px rgba(0,0,0,0.12);
}
.gig-card::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 2px;
  background: linear-gradient(180deg, rgba(74, 222, 128, 0.75), transparent);
  opacity: 0;
  transition: opacity 180ms ease;
}
.gig-card:not(:disabled):hover {
  transform: translateY(-2px);
  border-color: rgba(74, 222, 128, 0.32);
  background: linear-gradient(115deg, rgba(39, 57, 45, 0.96), rgba(22, 31, 25, 0.96));
  box-shadow: 0 12px 25px rgba(0,0,0,0.2), 0 0 20px rgba(16, 185, 129, 0.055);
}
.gig-card:not(:disabled):hover::before { opacity: 1; }
.gig-tier {
  padding: 3px 7px;
  border: 1px solid rgba(74, 222, 128, 0.2);
  border-radius: 6px;
  color: #86cba0;
  background: rgba(16, 185, 129, 0.08);
  letter-spacing: 0.08em;
}
.board-caption {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 10px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 9px;
  background: rgba(255,255,255,0.025);
  color: #829188;
  font-size: 9px;
  letter-spacing: 0.14em;
}
.board-live-dot, .boot-live-dot {
  width: 6px;
  height: 6px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.8);
  animation: live-pulse 1.8s ease-in-out infinite;
}

.boot-screen {
  position: relative;
  gap: 0;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 43%, rgba(20, 119, 74, 0.2), transparent 36%),
    radial-gradient(ellipse at 50% 100%, rgba(20, 48, 33, 0.22), transparent 44%),
    #070a08;
}
.boot-emblem {
  display: grid;
  place-items: center;
  width: 78px;
  height: 78px;
  margin-bottom: 25px;
  border: 1px solid rgba(74, 222, 128, 0.38);
  border-radius: 24px;
  background: linear-gradient(145deg, rgba(30, 78, 51, 0.72), rgba(10, 24, 16, 0.95));
  box-shadow: 0 0 45px rgba(16, 185, 129, 0.14), inset 0 1px 0 rgba(255,255,255,0.1);
  transform: rotate(-8deg);
  animation: emblem-float 3s ease-in-out infinite;
}
.boot-emblem-core {
  color: #b7f7c9;
  font-size: 39px;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 0 25px rgba(74, 222, 128, 0.5);
  transform: rotate(8deg);
}
.boot-wordmark {
  text-shadow: 0 3px 24px rgba(74, 222, 128, 0.12);
  animation: wordmark-in 550ms ease-out both;
}
.boot-caption {
  display: flex;
  align-items: center;
  gap: 9px;
}

.active-gig-screen {
  position: relative;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 42%, rgba(16, 100, 60, 0.13), transparent 42%);
}
.gig-orbit {
  position: relative;
  display: grid;
  place-items: center;
  width: 132px;
  height: 132px;
  margin-bottom: 8px;
}
.gig-orbit-ring {
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(74, 222, 128, 0.18);
  border-radius: 50%;
  box-shadow: 0 0 35px rgba(16, 185, 129, 0.07), inset 0 0 24px rgba(16, 185, 129, 0.04);
  animation: orbit-breathe 2.8s ease-in-out infinite;
}
.gig-orbit-ring::before,
.gig-orbit-ring::after {
  content: '';
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.9);
}
.gig-orbit-ring::before { top: 18px; right: 13px; }
.gig-orbit-ring::after { bottom: 20px; left: 11px; opacity: 0.45; }
.active-progress {
  display: flex;
  gap: 6px;
  width: 82px;
  margin: 7px 0 12px;
}
.active-progress span {
  display: block;
  height: 3px;
  flex: 1;
  border-radius: 99px;
  background: #3d9a68;
  animation: progress-glow 1.5s ease-in-out infinite;
}
.active-progress span:nth-child(2) { animation-delay: 180ms; }
.active-progress span:nth-child(3) { animation-delay: 360ms; }

@keyframes screen-enter {
  from { opacity: 0; transform: translateY(10px) scale(0.992); filter: blur(2px); }
  to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
}
@keyframes live-pulse {
  0%, 100% { opacity: 0.55; box-shadow: 0 0 4px rgba(74, 222, 128, 0.35); }
  50% { opacity: 1; box-shadow: 0 0 11px rgba(74, 222, 128, 0.95); }
}
@keyframes emblem-float {
  0%, 100% { transform: translateY(0) rotate(-8deg); }
  50% { transform: translateY(-7px) rotate(-5deg); }
}
@keyframes wordmark-in {
  from { opacity: 0; letter-spacing: 0.34em; transform: translateY(7px); }
  to { opacity: 1; letter-spacing: 0.22em; transform: translateY(0); }
}
@keyframes orbit-breathe {
  0%, 100% { transform: scale(0.94); opacity: 0.62; }
  50% { transform: scale(1.04); opacity: 1; }
}
@keyframes progress-glow {
  0%, 100% { opacity: 0.38; box-shadow: none; }
  50% { opacity: 1; box-shadow: 0 0 10px rgba(74, 222, 128, 0.35); }
}

/* Preserve a readable interface without motion for users who request it. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 480px) {
  .phone-stage { padding: 0; }
  .phone-device {
    width: 100%;
    max-width: none;
    min-height: 100vh;
    min-height: 100dvh;
    height: 100vh;
    height: 100dvh;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .phone-device::before { border-radius: 0; }
  .status-stat { padding: 3px 4px; font-size: 10px; }
}
